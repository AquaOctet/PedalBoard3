# Pedalboard 3 Linux CI image.
#
# Built once per Dockerfile / .gitlab-ci.yml change by the build:image:linux
# job (kaniko, weeb-cluster runner) and pushed to the project Container
# Registry as ${CI_REGISTRY_IMAGE}/ci-linux:latest. build:linux and
# test:linux:unit pull this image so they skip apt-install entirely.
#
# Base: Ubuntu 24.04 (noble). Has clang-18 / clang-format-18 / clang-tidy-18
# in the main archive — no LLVM apt repo needed — and `just` in universe.
# Also matches the runtime image developers test against locally.
#
# This image is for CI only. Phase-6 AppImage release builds want an older
# glibc for end-user back-compat; that lives in a future Dockerfile.linux-release
# and is out of scope here.

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG CMAKE_VERSION=3.28.6
ARG NINJA_VERSION=1.12.1

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# -- base + JUCE 8 Linux deps + toolchain -------------------------------------
# `just` is in 24.04 universe. clang-18 and friends are in 24.04 main, so we
# don't need the llvm.org apt repo dance.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget git unzip xz-utils file \
      build-essential pkg-config \
      python3 python3-pip \
      libasound2-dev libjack-jackd2-dev \
      libx11-dev libxrandr-dev libxinerama-dev libxcursor-dev \
      libxext-dev libxcomposite-dev libxrender-dev \
      libfreetype-dev libfontconfig1-dev \
      libgl-dev libglu1-mesa-dev mesa-common-dev \
      libcurl4-openssl-dev \
      libwebkit2gtk-4.1-dev \
      clang-18 clang-tools-18 clang-format-18 clang-tidy-18 lld-18 llvm-18 \
      ccache jq just \
   && update-alternatives --install /usr/bin/clang        clang        /usr/bin/clang-18        100 \
   && update-alternatives --install /usr/bin/clang++      clang++      /usr/bin/clang++-18      100 \
   && update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-18 100 \
   && update-alternatives --install /usr/bin/clang-tidy   clang-tidy   /usr/bin/clang-tidy-18   100 \
   && rm -rf /var/lib/apt/lists/*

# -- CMake (pinned, official upstream tarball — 24.04's apt cmake is older) ---
RUN curl -fsSL "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
     | tar -xz -C /opt \
 && ln -sf "/opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cmake" /usr/local/bin/cmake \
 && ln -sf "/opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/ctest" /usr/local/bin/ctest \
 && ln -sf "/opt/cmake-${CMAKE_VERSION}-linux-x86_64/bin/cpack" /usr/local/bin/cpack

# -- Ninja --------------------------------------------------------------------
RUN curl -fsSL "https://github.com/ninja-build/ninja/releases/download/v${NINJA_VERSION}/ninja-linux.zip" \
        -o /tmp/ninja.zip \
 && unzip -q /tmp/ninja.zip -d /usr/local/bin \
 && rm /tmp/ninja.zip

ENV PATH="/usr/local/bin:${PATH}"
WORKDIR /workspace
